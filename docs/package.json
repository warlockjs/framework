{
  "name": "@warlock.js/docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Warlock.js framework docs site \u2014 Starlight + Tailwind, deployed to warlock.js.org.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "docs"
  },
  "scripts": {
    "sync:changelog": "node scripts/generate-changelog.mjs",
    "test:changelog": "node --test scripts/generate-changelog.test.mjs",
    "check:changelog-freshness": "node scripts/check-changelog-freshness.mjs",
    "test:changelog-freshness": "node --test scripts/check-changelog-freshness.test.mjs",
    "check:mdx-guard": "node scripts/check-mdx-in-md.mjs && node scripts/check-tab-code-fences.mjs",
    "test:mdx-guard": "node --test scripts/check-tab-code-fences.test.mjs",
    "predev": "node scripts/generate-changelog.mjs && node scripts/generate-skills.mjs",
    "prestart": "node scripts/generate-changelog.mjs && node scripts/generate-skills.mjs",
    "prebuild": "node scripts/check-mdx-in-md.mjs && node scripts/check-tab-code-fences.mjs && node scripts/generate-changelog.mjs && node scripts/check-changelog-freshness.mjs && node scripts/generate-skills.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/check-mdx-gfm.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:gfm-check": "node --test scripts/check-mdx-gfm.test.mjs",
    "sync:skills": "node scripts/generate-skills.mjs",
    "test:skills": "node --test scripts/generate-skills.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.6",
    "astro-mermaid": "^2.0.1",
    "mermaid": "^11.15.0",
    "sharp": "^0.34.5",
    "starlight-sidebar-topics": "^0.7.1"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
