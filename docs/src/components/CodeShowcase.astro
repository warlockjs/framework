---
/**
 * Three compact code previews showing the surfaces of one Warlock app:
 * a server-rendered React page, an HTTP route, and an AI agent.
 */
import { Code } from "@astrojs/starlight/components";

const pageSnippet = `import type { PageLoader, PageProps } from "@warlock.js/web";
import { catalog } from "app/products/catalog";
import ProductGrid from "./product-grid";

export const loader = (async () => ({
  products: await catalog.list(),
})) satisfies PageLoader;

export default function Products({ data }: PageProps<typeof loader>) {
  return <ProductGrid items={data.products} />;
}`;

const routeSnippet = `import { router } from "@warlock.js/core";
import { createProduct, listProducts, showProduct } from "./controllers";

router.get("/api/products", listProducts);
router.post("/api/products", createProduct);
router.get("/api/products/:id", showProduct);`;

const agentSnippet = `import { ai } from "@warlock.js/ai";
import { openai } from "./providers";

export const supportAgent = ai.agent({
  model: openai.model({ name: "gpt-4o-mini" }),
  systemPrompt: "Help customers choose a product.",
});

export function recommendProduct(prompt: string) {
  return supportAgent.execute(prompt);
}`;
---

<section class="warlock-showcase">
  <div class="warlock-section-head">
    <p class="warlock-section-kicker">[ One app, every surface ]</p>
    <h2 class="warlock-section-title">Pages, APIs, and agents belong together</h2>
    <p class="warlock-section-sub">
      Render React on the server, expose typed HTTP routes, and give agents
      the same application capabilities — inside one lifecycle and one codebase.
    </p>
  </div>

  <div class="warlock-showcase-grid">
    <article class="warlock-showcase-card">
      <header class="warlock-showcase-head">
        <span class="warlock-showcase-tag">SSR page</span>
        <span class="warlock-showcase-file">src/web/products/index.page.tsx</span>
      </header>
      <Code code={pageSnippet} lang="tsx" />
      <p class="warlock-showcase-note">
        A typed loader feeds the same React component on the server and in the
        browser. Routing, metadata, layouts, hydration, and navigation live in
        <a href="/v/latest/web/">web</a>.
      </p>
    </article>

    <article class="warlock-showcase-card">
      <header class="warlock-showcase-head">
        <span class="warlock-showcase-tag">HTTP API</span>
        <span class="warlock-showcase-file">src/app/products/routes.ts</span>
      </header>
      <Code code={routeSnippet} lang="ts" />
      <p class="warlock-showcase-note">
        One line registers an endpoint. Controllers, validation, response
        helpers, middleware, and module conventions live in
        <a href="/v/latest/core/the-basics/02-routing/">core</a>.
      </p>
    </article>

    <article class="warlock-showcase-card">
      <header class="warlock-showcase-head">
        <span class="warlock-showcase-tag">AI agent</span>
        <span class="warlock-showcase-file">src/app/support/agents/triage.ts</span>
      </header>
      <Code code={agentSnippet} lang="ts" />
      <p class="warlock-showcase-note">
        Pick a provider and define an agent beside the rest of the app. Tools,
        retries, structured output, workflows, and middleware live in
        <a href="/v/latest/ai/">ai</a>.
      </p>
    </article>
  </div>
</section>

<style>
  .warlock-showcase {
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(3rem, 4rem + 2vw, 5rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .warlock-showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-block-start: 2.5rem;
  }

  @media (min-width: 64rem) {
    .warlock-showcase-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .warlock-showcase-card {
    /* Reset Starlight's `.sl-markdown-content` auto-flow margin
     * (`:where(…) + :where(…) { margin-top: 1rem }`) — it leaks onto the
     * later grid items and knocks the code cards out of line. */
    margin: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--warlock-radius);
    background-color: var(--warlock-surface-dark);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  :root[data-theme="light"] .warlock-showcase-card {
    background-color: #ffffff;
  }

  .warlock-showcase-card:hover {
    border-color: color-mix(in srgb, var(--sl-color-text-accent) 50%, var(--sl-color-hairline));
    transform: translateY(-2px);
  }

  .warlock-showcase-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  .warlock-showcase-tag {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .warlock-showcase-file {
    color: var(--sl-color-gray-3);
    font-weight: 500;
    max-width: 62%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .warlock-showcase-card :global(.expressive-code) {
    margin: 0 !important;
  }

  .warlock-showcase-card :global(.expressive-code .frame) {
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  /* Ensure code shrinks to fit the card — no overflow into adjacent. */
  .warlock-showcase-card :global(.expressive-code pre) {
    font-size: 0.78rem !important;
    line-height: 1.55 !important;
  }

  .warlock-showcase-card :global(.expressive-code pre code) {
    white-space: pre;
  }

  /* Side-scroll the code rather than letting it overflow the card. */
  .warlock-showcase-card :global(.expressive-code .copy) {
    top: 0.35rem !important;
    right: 0.35rem !important;
  }

  .warlock-showcase-note {
    padding: 1rem;
    margin: auto 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .warlock-showcase-note a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--sl-color-text-accent) 40%, transparent);
    text-underline-offset: 3px;
  }
</style>
