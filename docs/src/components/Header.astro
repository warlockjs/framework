---
/**
 * Custom Warlock.js header — full replacement of Starlight's default
 * Header component.
 *
 * Layout: brand mark + wordmark + version pill on the left, top-nav in
 * the middle (desktop only), search + theme + GitHub + mobile-trigger
 * on the right. Sticky with backdrop blur.
 *
 * We render Starlight's own Search and ThemeSelect inside our own
 * layout so search and theme toggle keep working without re-implementing
 * them.
 */
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import { getCollection } from "astro:content";
import logo from "../assets/logo.png";

const navLinks = [
  { label: "Documentation", href: "/v/latest/core/getting-started/01-introduction/" },
  { label: "Upgrade to v5", href: "/v/latest/upgrade-to-v5/", upgrade: true },
  { label: "AI", href: "/v/latest/ai/", ai: true },
  { label: "Features", href: "/features/" },
  { label: "Packages", href: "/packages/" },
  { label: "Skills", href: "/skills/" },
  { label: "Change Log", href: "/changelog/" },
];

const currentPath = Astro.url.pathname;
const onAiDocs = /^\/v\/(?:latest|v4)\/ai(?:\/|$)/.test(currentPath);
const currentDocsVersion = currentPath.match(/^\/v\/(latest|v4)(?=\/|$)/)?.[1];
const readingVersion = currentDocsVersion === "v4" ? "v4" : "v5";

const normalizePath = (path: string) => {
  const withLeadingSlash = path.startsWith("/") ? path : `/${path}`;
  return withLeadingSlash === "/" ? "/" : `${withLeadingSlash.replace(/\/$/, "")}/`;
};

// Only preserve the current page when that exact counterpart exists. New v5
// pages (such as the upgrade guide) safely fall back to each version's intro.
const docs = await getCollection("docs");
const docRoutes = new Set(
  docs
    .filter(({ data }) => import.meta.env.MODE !== "production" || data.draft === false)
    .map(({ id }) => normalizePath(id === "index" ? "/" : id)),
);
const versionHref = (version: "latest" | "v4") => {
  if (currentDocsVersion) {
    const counterpart = normalizePath(
      currentPath.replace(/^\/v\/(?:latest|v4)(?=\/|$)/, `/v/${version}`),
    );
    if (docRoutes.has(counterpart)) return counterpart;
  }

  return `/v/${version}/core/getting-started/01-introduction/`;
};

const latestHref = versionHref("latest");
const v4Href = versionHref("v4");
function isActive(link) {
  const { href, ai, upgrade } = link;
  if (upgrade) return currentPath === href || currentPath === href.slice(0, -1);
  if (ai) return onAiDocs;
  if (href === "/features/") return currentPath === "/features/";
  if (href === "/packages/") return currentPath === "/packages/";
  if (href === "/skills/") return currentPath === "/skills/";
  if (href === "/changelog/") return currentPath === "/changelog/";
  // Any other package's docs light up "Documentation" — but not the AI
  // section, which owns its own nav entry.
  if (href.startsWith("/v/latest/")) return currentPath.startsWith("/v/") && !onAiDocs;
  return false;
}
---

<div class="warlock-header">
  <div class="warlock-header-inner">
    <div class="warlock-brand-cluster">
      <a class="warlock-brand" href="/" aria-label="Warlock.js home">
        <span class="warlock-brand-mark-wrap" aria-hidden="true">
          <img src={logo.src} alt="" width="28" height="28" class="warlock-brand-mark" />
        </span>
        <span class="warlock-brand-name">Warlock<span class="warlock-brand-tld">.js</span></span>
      </a>

      <details class="warlock-version-picker">
        <summary aria-label={`Documentation version: ${readingVersion}`}>
          Docs {readingVersion}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="warlock-version-menu">
          <a href={latestHref} aria-current={currentDocsVersion !== "v4" ? "page" : undefined}>
            <span>v5</span>
            <small>Current</small>
          </a>
          <a href={v4Href} aria-current={currentDocsVersion === "v4" ? "page" : undefined}>
            <span>v4</span>
            <small>Frozen</small>
          </a>
        </div>
      </details>
    </div>

    <nav class="warlock-topnav" aria-label="Top">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "warlock-topnav-link",
            link.ai && "warlock-topnav-ai",
            isActive(link) && "is-active",
          ]}
        >
          {link.ai && (
            <svg
              class="warlock-ai-spark"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 2.6l1.75 6.15L20 10.5l-6.25 1.75L12 18.4l-1.75-6.15L4 10.5l6.25-1.75z" />
              <path d="M18.7 3.1l.62 2.18 2.18.62-2.18.62-.62 2.18-.62-2.18-2.18-.62 2.18-.62z" />
            </svg>
          )}
          {link.label}
        </a>
      ))}
    </nav>

    <div class="warlock-header-actions">
      <div class="warlock-search-slot">
        <Search />
      </div>

      <a
        class="warlock-icon-link"
        href="https://github.com/warlockjs/core"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.16c-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18A11.02 11.02 0 0 1 12 6.8c.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.82 1.19 3.08 0 4.42-2.69 5.39-5.26 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.67.79.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>

      <div class="warlock-theme-slot">
        <ThemeSelect />
      </div>

      <starlight-menu-button class="warlock-menu-button" />
    </div>
  </div>
</div>

<style>
  /* Outer <header class="header"> (Starlight) already provides fixed
   * positioning, height, background. We just paint layout here. */
  .warlock-header {
    width: 100%;
    height: 100%;
  }

  .warlock-header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
    /* Outer wrapper already pads via --sl-nav-pad-* — match it horizontally */
    max-width: none;
    margin: 0;
  }

  /* Brand block */
  .warlock-brand-cluster {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: max-content;
  }

  .warlock-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none !important;
    color: var(--sl-color-white) !important;
    line-height: 1;
    transition: opacity 0.15s ease;
  }

  .warlock-brand:hover {
    opacity: 0.85;
  }

  .warlock-brand-mark-wrap {
    position: relative;
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border-radius: var(--warlock-radius-sm);
  }

  .warlock-brand-mark-wrap::before {
    content: "";
    position: absolute;
    inset: -4px;
    background: radial-gradient(circle, var(--warlock-yellow-glow) 0%, transparent 70%);
    filter: blur(6px);
    opacity: 0.7;
    pointer-events: none;
  }

  .warlock-brand-mark {
    position: relative;
    display: block;
    width: 28px;
    height: auto;
    filter: drop-shadow(0 0 4px var(--warlock-yellow-glow));
  }

  .warlock-brand-name {
    font-family: var(--sl-font);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .warlock-brand-tld {
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }

  .warlock-version-picker {
    position: relative;
  }

  .warlock-version-picker summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.5rem;
    border-radius: var(--warlock-radius-sm);
    background-color: var(--warlock-yellow-glow);
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    list-style: none;
  }

  .warlock-version-picker summary::-webkit-details-marker {
    display: none;
  }

  .warlock-version-picker[open] summary svg {
    transform: rotate(180deg);
  }

  .warlock-version-menu {
    position: absolute;
    z-index: 20;
    inset-block-start: calc(100% + 0.55rem);
    inset-inline-start: 0;
    width: 9.5rem;
    padding: 0.35rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--warlock-radius);
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-lg);
  }

  .warlock-version-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--warlock-radius-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .warlock-version-menu a:hover,
  .warlock-version-menu a[aria-current="page"] {
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
  }

  .warlock-version-menu small {
    color: var(--sl-color-gray-3);
    font-size: 0.68rem;
  }

  @media (max-width: 34rem) {
    .warlock-brand-name {
      display: none;
    }
  }

  /* Top nav (centered) */
  .warlock-topnav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  @media (min-width: 60rem) {
    .warlock-topnav {
      display: flex;
    }
  }

  .warlock-topnav-link {
    position: relative;
    padding: 0.5rem 0.85rem;
    border-radius: var(--warlock-radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none !important;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .warlock-topnav-link:hover {
    color: var(--sl-color-white);
    background-color: color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
  }

  .warlock-topnav-link.is-active {
    color: var(--sl-color-text-accent);
    background-color: color-mix(in srgb, var(--sl-color-text-accent) 12%, transparent);
  }

  /* AI — the one nav entry we deliberately elevate. An accent-tinted pill
   * with a twinkling sparkle and a soft yellow glow, echoing the brand
   * mark's glow and the AiSpotlight provider dots. Selectors are qualified
   * with .warlock-topnav-link so the gradient wins over the base
   * .is-active background. */
  .warlock-topnav-link.warlock-topnav-ai {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
    border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 32%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--sl-color-text-accent) 12%, transparent),
      color-mix(in srgb, var(--sl-color-text-accent) 5%, transparent)
    );
    transition:
      color 0.15s ease,
      background 0.2s ease,
      border-color 0.15s ease,
      box-shadow 0.25s ease;
  }

  .warlock-topnav-link.warlock-topnav-ai:hover {
    color: var(--sl-color-text-accent);
    border-color: color-mix(in srgb, var(--sl-color-text-accent) 55%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--sl-color-text-accent) 20%, transparent),
      color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent)
    );
    box-shadow: 0 0 14px color-mix(in srgb, var(--sl-color-text-accent) 30%, transparent);
  }

  .warlock-topnav-link.warlock-topnav-ai.is-active {
    border-color: color-mix(in srgb, var(--sl-color-text-accent) 55%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--sl-color-text-accent) 22%, transparent);
  }

  .warlock-ai-spark {
    flex: none;
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--sl-color-text-accent) 70%, transparent));
  }

  @media (prefers-reduced-motion: no-preference) {
    .warlock-topnav-ai .warlock-ai-spark {
      transform-origin: center;
      animation: warlock-ai-twinkle 3.2s ease-in-out infinite;
    }

    @keyframes warlock-ai-twinkle {
      0%,
      100% {
        opacity: 0.85;
        transform: scale(1) rotate(0deg);
      }
      50% {
        opacity: 1;
        transform: scale(1.14) rotate(9deg);
      }
    }
  }

  /* Right-side actions */
  .warlock-header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: end;
  }

  /* Tame Starlight's Search internal markup to fit our row */
  .warlock-search-slot :global(button[aria-keyshortcuts]),
  .warlock-search-slot :global(button[data-open-modal]) {
    height: 34px;
    border-radius: var(--warlock-radius) !important;
    border: 1px solid var(--sl-color-hairline) !important;
    background-color: var(--warlock-surface-dark);
    color: var(--sl-color-gray-2) !important;
    padding: 0 0.7rem !important;
    font-family: var(--sl-font);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  :root[data-theme="light"] .warlock-search-slot :global(button[data-open-modal]) {
    background-color: #ffffff;
  }

  .warlock-search-slot :global(button[data-open-modal]:hover) {
    border-color: var(--sl-color-text-accent) !important;
    color: var(--sl-color-white) !important;
  }

  .warlock-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--warlock-radius);
    color: var(--sl-color-gray-2);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .warlock-icon-link:hover {
    color: var(--sl-color-text-accent);
    background-color: color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
  }

  /* Tame Starlight's ThemeSelect button */
  .warlock-theme-slot :global(starlight-theme-select select),
  .warlock-theme-slot :global(label) {
    border-radius: var(--warlock-radius) !important;
  }

  /* Mobile menu button hidden on desktop (Starlight handles the hookup) */
  .warlock-menu-button {
    display: inline-flex;
  }

  @media (min-width: 50rem) {
    .warlock-menu-button {
      display: none;
    }
  }
</style>
