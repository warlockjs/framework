---
/**
 * Alternate homepage concept mounted only at /home2.
 *
 * The visual language is an editorial runtime map: it explains how Warlock's
 * product surfaces compose instead of repeating the current landing page.
 */
import "../styles/home2.css";

const surfaces = [
  {
    id: "01",
    label: "Web",
    title: "React, delivered by the framework",
    body: "File-based pages, typed loaders, server rendering, layouts, metadata, hydration, and client navigation.",
    href: "/v/latest/web/",
    className: "home2-surface--web",
  },
  {
    id: "02",
    label: "Core",
    title: "An application kernel with opinions",
    body: "Routes, modules, middleware, validation, services, configuration, mail, files, and the lifecycle around them.",
    href: "/v/latest/core/",
    className: "home2-surface--core",
  },
  {
    id: "03",
    label: "Data",
    title: "Models that stay close to the domain",
    body: "Query, relate, paginate, transact, cache, and observe data without leaving the application model.",
    href: "/v/latest/cascade/",
    className: "home2-surface--data",
  },
  {
    id: "04",
    label: "AI",
    title: "Agents as application code",
    body: "Providers, tools, structured output, workflows, RAG, guardrails, evaluation, and durable execution.",
    href: "/v/latest/ai/",
    className: "home2-surface--ai",
  },
];

const lifecycle = [
  ["01", "Page", "React enters through a typed loader"],
  ["02", "Module", "Domain logic stays reusable"],
  ["03", "Data", "Models answer inside a transaction"],
  ["04", "Agent", "The same capabilities become tools"],
];
---

<main class="warlock-home2">
  <section class="home2-hero" aria-labelledby="home2-title">
    <div class="home2-noise" aria-hidden="true"></div>
    <div class="home2-orbit home2-orbit--one" aria-hidden="true"></div>
    <div class="home2-orbit home2-orbit--two" aria-hidden="true"></div>

    <div class="home2-shell home2-hero-grid">
      <div class="home2-hero-copy">
        <p class="home2-overline">
          <span class="home2-live-dot" aria-hidden="true"></span>
          The TypeScript application framework
        </p>

        <h1 id="home2-title">
          Build the product.
          <span>Keep the context.</span>
        </h1>

        <p class="home2-lede">
          Warlock brings server-rendered React, HTTP, data, and AI into one
          modular application — so every surface can share the same typed core.
        </p>

        <div class="home2-actions">
          <a class="home2-button home2-button--primary" href="/v/latest/core/getting-started/01-introduction/">
            Start building
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4"></path>
            </svg>
          </a>
          <a class="home2-button home2-button--quiet" href="/features/">Explore the system</a>
        </div>

        <div class="home2-install" aria-label="Install Warlock.js">
          <span class="home2-prompt" aria-hidden="true">$</span>
          <code>npm create warlock@latest my-app</code>
          <span class="home2-install-note">one app / every surface</span>
        </div>
      </div>

      <div class="home2-runtime" aria-label="Warlock application runtime diagram">
        <div class="home2-runtime-head">
          <div class="home2-window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span>product.runtime</span>
          <span class="home2-runtime-ready">ready</span>
        </div>

        <div class="home2-runtime-canvas">
          <div class="home2-request-node">
            <span>incoming</span>
            <strong>request</strong>
            <small>GET /products</small>
          </div>

          <svg class="home2-runtime-lines" viewBox="0 0 520 270" preserveAspectRatio="none" aria-hidden="true">
            <path d="M260 48V86M260 86H105V125M260 86H208V125M260 86H312V125M260 86H415V125"></path>
          </svg>

          <div class="home2-runtime-modules">
            <a href="/v/latest/web/" class="home2-module home2-module--web">
              <span>01</span><strong>web</strong><small>render</small>
            </a>
            <a href="/v/latest/core/" class="home2-module home2-module--core">
              <span>02</span><strong>core</strong><small>route</small>
            </a>
            <a href="/v/latest/cascade/" class="home2-module home2-module--data">
              <span>03</span><strong>data</strong><small>query</small>
            </a>
            <a href="/v/latest/ai/" class="home2-module home2-module--ai">
              <span>04</span><strong>ai</strong><small>reason</small>
            </a>
          </div>

          <div class="home2-shared-core">
            <span class="home2-shared-label">shared application context</span>
            <div><span>types</span><span>services</span><span>policies</span><span>events</span></div>
          </div>
        </div>

        <div class="home2-runtime-foot">
          <span>node · typescript</span>
          <span><b>4</b> surfaces / <b>1</b> lifecycle</span>
        </div>
      </div>
    </div>

    <div class="home2-shell home2-proof" aria-label="Warlock highlights">
      <span>Server-rendered React</span>
      <span>Typed HTTP</span>
      <span>Composable packages</span>
      <span>Production AI primitives</span>
    </div>
  </section>

  <section class="home2-lifecycle" aria-labelledby="home2-lifecycle-title">
    <div class="home2-shell">
      <div class="home2-section-intro">
        <p class="home2-kicker">One request, one lifecycle</p>
        <h2 id="home2-lifecycle-title">The handoffs disappear.</h2>
        <p>
          A product is more than a frontend calling an API. Warlock lets each layer
          participate in the same application context, from the first request to the last tool call.
        </p>
      </div>

      <ol class="home2-flow">
        {lifecycle.map(([id, title, body]) => (
          <li>
            <span class="home2-flow-id">{id}</span>
            <div>
              <strong>{title}</strong>
              <p>{body}</p>
            </div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"></path></svg>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home2-system" aria-labelledby="home2-system-title">
    <div class="home2-shell">
      <div class="home2-section-row">
        <div class="home2-section-intro">
          <p class="home2-kicker">A framework that expands with the product</p>
          <h2 id="home2-system-title">Start with a page. Add the system.</h2>
        </div>
        <a class="home2-text-link" href="/packages/">
          Browse every package
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
        </a>
      </div>

      <div class="home2-surface-grid">
        {surfaces.map((surface) => (
          <a class:list={["home2-surface", surface.className]} href={surface.href}>
            <span class="home2-surface-id">{surface.id} / {surface.label}</span>
            <h3>{surface.title}</h3>
            <p>{surface.body}</p>
            <span class="home2-surface-link">
              Open docs
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
            </span>
            <span class="home2-surface-glyph" aria-hidden="true">{surface.id}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home2-code" aria-labelledby="home2-code-title">
    <div class="home2-shell home2-code-grid">
      <div class="home2-code-copy">
        <p class="home2-kicker">The useful kind of full-stack</p>
        <h2 id="home2-code-title">Domain code that does not care who called it.</h2>
        <p>
          Keep business capabilities in modules. A page loader, an HTTP controller,
          and an agent tool can call the same typed service without crossing an artificial boundary.
        </p>
        <ul>
          <li><span>01</span>One dependency graph</li>
          <li><span>02</span>One configuration model</li>
          <li><span>03</span>One place to observe behavior</li>
        </ul>
      </div>

      <div class="home2-editor">
        <div class="home2-editor-tabs">
          <span class="is-active">product.page.tsx</span>
          <span>catalog.ts</span>
          <span>recommend.ts</span>
        </div>
        <pre aria-label="Warlock TypeScript example"><code><span class="tok-key">export const</span> loader = <span class="tok-key">async</span> () =&gt; (&#123;
  products: <span class="tok-key">await</span> catalog.<span class="tok-fn">list</span>(),
  picks: <span class="tok-key">await</span> recommend.<span class="tok-fn">for</span>(user),
&#125;);

<span class="tok-key">export default function</span> <span class="tok-fn">Products</span>(&#123; data &#125;) &#123;
  <span class="tok-key">return</span> &lt;<span class="tok-tag">Catalog</span> items=&#123;data.products&#125;
    recommended=&#123;data.picks&#125; /&gt;;
&#125;</code></pre>
        <div class="home2-editor-status">
          <span>TypeScript</span>
          <span><i aria-hidden="true"></i> types connected</span>
        </div>
      </div>
    </div>
  </section>

  <section class="home2-cta" aria-labelledby="home2-cta-title">
    <div class="home2-shell home2-cta-inner">
      <p class="home2-kicker">Make the next surface cheap</p>
      <h2 id="home2-cta-title">Build a product that can keep becoming.</h2>
      <p>Begin with the application kernel, then reach for Web, data, or AI when the product asks for them.</p>
      <div class="home2-actions home2-actions--center">
        <a class="home2-button home2-button--primary" href="/v/latest/core/getting-started/01-introduction/">
          Read the guide
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
        </a>
        <a class="home2-button home2-button--quiet" href="https://github.com/warlockjs/core">View on GitHub</a>
      </div>
    </div>
  </section>
</main>
