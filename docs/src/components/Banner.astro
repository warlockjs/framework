---
/**
 * Starlight banner override: preserve per-page banners everywhere and show a
 * frozen-version notice on routes under /v/v4/.
 */
import Default from "@astrojs/starlight/components/Banner.astro";

const isV4 = /^\/v\/v4(?:\/|$)/.test(Astro.url.pathname);
---

{isV4 && (
    <div class="sl-banner" data-pagefind-ignore>
      You are reading the frozen <strong>Warlock.js v4 documentation</strong>.
      {" "}<a href="/v/latest/core/getting-started/01-introduction/">Read the current v5 docs</a>
      {" | "}<a href="/v/latest/core/upgrade-to-v5/">Upgrade to v5</a>
    </div>
)}

<Default />

<style>
  @layer starlight.core {
    .sl-banner {
      --__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
      color: var(--__sl-banner-text);
      line-height: var(--sl-line-height-headings);
      text-align: center;
      text-wrap: balance;
      box-shadow: var(--sl-shadow-sm);
    }

    .sl-banner :global(a) {
      color: var(--__sl-banner-text);
      font-weight: 600;
    }
  }
</style>
