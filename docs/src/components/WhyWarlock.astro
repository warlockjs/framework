---
/**
 * "Why Warlock" — the positioning, as four principles. Editorial column
 * layout (numbered, thin accent rule) so it reads distinct from the bordered
 * PathPicker cards further down. Copy is grounded in the package descriptions,
 * not marketing invention.
 */
const principles = [
  {
    title: "UI and server, one application",
    body: "Server-rendered React pages boot inside the same Warlock lifecycle as routes, modules, middleware, and services — no second app to stitch together.",
  },
  {
    title: "Typed end to end",
    body: "Seal schemas are validation, TypeScript types, and JSON schema at once. Define a shape once; it holds at the edge, in the compiler, and in tool calls.",
  },
  {
    title: "One backend for people and agents",
    body: "Pages, HTTP endpoints, and AI tools can call the same domain code. Add a new surface without rebuilding the product behind it.",
  },
  {
    title: "Full-stack, still modular",
    body: "Start with Core and Web, then add Cascade, cache, auth, queues, or AI only when the product reaches for them. Every package remains independently installable.",
  },
];
---

<section class="warlock-why">
  <div class="warlock-section-head">
    <p class="warlock-section-kicker">[ Why Warlock ]</p>
    <h2 class="warlock-section-title">One application, one mental model</h2>
    <p class="warlock-section-sub">
      Browser UI, server logic, data, and agents compose through the same typed
      modules instead of meeting across framework seams.
    </p>
  </div>

  <div class="warlock-why-grid">
    {principles.map((p, i) => (
      <div class="warlock-why-item">
        <span class="warlock-why-num">0{i + 1}</span>
        <span class="warlock-why-rule" aria-hidden="true"></span>
        <h3 class="warlock-why-title">{p.title}</h3>
        <p class="warlock-why-body">{p.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .warlock-why {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3rem, 4rem + 2vw, 5rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .warlock-why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-block-start: 2.5rem;
  }

  @media (min-width: 40rem) {
    .warlock-why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 2.5rem;
    }
  }

  @media (min-width: 64rem) {
    .warlock-why-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }
  }

  .warlock-why-item {
    display: flex;
    flex-direction: column;
  }

  .warlock-why-num {
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--sl-color-text-accent);
  }

  .warlock-why-rule {
    width: 2rem;
    height: 2px;
    margin-block: 0.85rem 1.1rem;
    background: linear-gradient(90deg, var(--sl-color-text-accent), transparent);
    border-radius: 2px;
  }

  .warlock-why-title {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.3;
    color: var(--sl-color-white);
  }

  .warlock-why-body {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
</style>
