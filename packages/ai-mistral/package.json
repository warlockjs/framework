{
  "name": "@warlock.js/ai-mistral",
  "version": "5.2.3",
  "type": "module",
  "description": "Mistral AI adapter for @warlock.js/ai (OpenAI-compatible)",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
