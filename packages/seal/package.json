{
  "name": "@warlock.js/seal",
  "version": "5.32.0",
  "type": "module",
  "description": "Comprehensive Validation library",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./object": {
      "types": "./src/object.ts",
      "import": "./src/object.ts",
      "default": "./src/object.ts"
    },
    "./string": {
      "types": "./src/string.ts",
      "import": "./src/string.ts",
      "default": "./src/string.ts"
    }
  },
  "warlock": {
    "environment": "universal"
  },
  "dependencies": {
    "@mongez/supportive-is": "^3.0.0",
    "@mongez/reinforcements": "^4.0.2",
    "dayjs": "^1.11.9"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "bench:types": "node scripts/bench-types.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint ./tests/**/*.{ts,tsx,json,md}",
    "lint:fix": "eslint ./tests/**/*.{ts,tsx,json,md} --fix",
    "format": "prettier --write ./tests/**/*.{ts,tsx,json,md}",
    "format:check": "prettier --check ./tests/**/*.{ts,tsx,json,md}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/seal"
  },
  "keywords": [
    "validation",
    "typescript",
    "framework-agnostic",
    "seal",
    "warlock.js"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^3.1.0",
    "prettier": "^3.2.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "packageManager": "pnpm@11.24.0"
}
