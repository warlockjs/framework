{
  "name": "@warlock.js/seal",
  "version": "5.2.0",
  "type": "module",
  "description": "Comprehensive Validation library",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "universal"
  },
  "dependencies": {
    "@mongez/supportive-is": "^2.1.4",
    "@mongez/reinforcements": "^4.0.1",
    "dayjs": "^1.11.9"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint ./tests/**/*.{ts,tsx,json,md}",
    "lint:fix": "eslint ./tests/**/*.{ts,tsx,json,md} --fix",
    "format": "prettier --write ./tests/**/*.{ts,tsx,json,md}",
    "format:check": "prettier --check ./tests/**/*.{ts,tsx,json,md}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/seal"
  },
  "keywords": [
    "validation",
    "typescript",
    "framework-agnostic",
    "seal",
    "warlock.js"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^3.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "packageManager": "pnpm@11.24.0"
}
