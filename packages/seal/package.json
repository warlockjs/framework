{
  "name": "@warlock.js/seal",
  "version": "5.39.2",
  "type": "module",
  "description": "Comprehensive Validation library",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./object": {
      "types": "./src/object.ts",
      "import": "./src/object.ts",
      "default": "./src/object.ts"
    },
    "./string": {
      "types": "./src/string.ts",
      "import": "./src/string.ts",
      "default": "./src/string.ts"
    }
  },
  "warlock": {
    "environment": "universal"
  },
  "dependencies": {
    "@mongez/supportive-is": "^3.0.0",
    "@mongez/reinforcements": "^4.0.2",
    "dayjs": "^1.11.9"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "bench:types": "node scripts/bench-types.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "node ../../node_modules/oxlint/bin/oxlint --config ../../.oxlintrc.json ./tests",
    "lint:fix": "node ../../node_modules/oxlint/bin/oxlint --config ../../.oxlintrc.json --fix ./tests",
    "format": "node ../../node_modules/oxfmt/bin/oxfmt --config ../../.oxfmtrc.json --disable-nested-config --write ./tests",
    "format:check": "node ../../node_modules/oxfmt/bin/oxfmt --config ../../.oxfmtrc.json --disable-nested-config --check ./tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/seal"
  },
  "keywords": [
    "validation",
    "typescript",
    "framework-agnostic",
    "seal",
    "warlock.js"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "packageManager": "pnpm@11.24.0"
}
