{
  "name": "@warlock.js/ai-workspace",
  "version": "5.35.0",
  "type": "module",
  "description": "Policy-jailed filesystem + shell workspace for @warlock.js/ai agents",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
