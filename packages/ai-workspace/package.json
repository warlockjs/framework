  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@warlock.js/ai": "*"
  },
  "dependencies": {
    "@warlock.js/fs": "*"
  }
