    "llms": "node scripts/generate-llms.mjs"
  },
  "keywords": [
    "warlock",
    "ai",
    "workspace",
    "agent",
    "filesystem",
    "shell",
    "sandbox",
    "tools"
  ],
  "author": "Hasan Zohdy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/ai-workspace"
  },
  "devDependencies": {
    "@warlock.js/ai": "workspace:^",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@warlock.js/ai": "*"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@warlock.js/fs": "workspace:^"
  },
  "packageManager": "pnpm@11.24.0"
}
