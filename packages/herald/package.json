{
  "name": "@warlock.js/herald",
  "version": "5.34.1",
  "type": "module",
  "description": "Message bus/brokers for RabbitMQ, Kafka, and more",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "dependencies": {
    "@mongez/copper": "^2.1.3",
    "@mongez/events": "^2.2.8",
    "@mongez/reinforcements": "^4.0.2",
    "@warlock.js/logger": "workspace:^",
    "@warlock.js/seal": "workspace:^"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "update": "npx ncu -u",
    "fix": "node ../../node_modules/oxlint/bin/oxlint --config ../../.oxlintrc.json --fix ./src",
    "format": "node ../../node_modules/oxfmt/bin/oxfmt --config ../../.oxfmtrc.json --disable-nested-config --write ./src",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/herald"
  },
  "peerDependencies": {
    "amqplib": "^0.10.0"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    }
  },
  "keywords": [
    "message-bus",
    "rabbitmq",
    "kafka",
    "queue",
    "pub-sub",
    "broker",
    "herald",
    "amqp",
    "message-broker"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "4.1.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.24.0"
}
