{
  // Inherits the workspace strictness contract (`strict`,
  // `noUncheckedIndexedAccess`, `forceConsistentCasingInFileNames`).
  //
  // Workspace packages are consumed as TypeScript SOURCE through the `exports`
  // map (canon `0a3227cc`), so this package's own `tsc -p` compiles its whole
  // dependency closure. Adoption was blocked until ai-openai and cache were
  // clean at source; neither needed a change here.
  //
  // A package may ADD to this contract. It must never subtract.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": ["node"],
    "target": "ES2020",
    // Raised from the ES2020 default because the shared source in sibling packages
    // uses ES2022 APIs (Object.hasOwn, String.replaceAll, Array.at), and a consumer
    // compiles that source under ITS OWN lib. DOM is listed explicitly because an
    // UNSET lib resolves to the .full variant, which bundles DOM - so naming a lib
    // without it would silently drop DOM types this package already relied on.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@warlock.js/ai": ["../ai/src"],
      "@warlock.js/ai-openai": ["../ai-openai/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
