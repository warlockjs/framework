{
  "name": "create-warlock",
  "version": "5.34.1",
  "description": "Project scaffolder for the Warlock.js framework — interactive wizard and non-interactive CLI for creating new apps.",
  "main": "./src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/create-warlock"
  },
  "type": "module",
  "bin": {
    "create-warlock": "./bin/create-app.js"
  },
  "scripts": {
    "start": "node node_modules/tsx/dist/cli.mjs ./index.dev.ts",
    "lint": "node ../../node_modules/oxlint/bin/oxlint --config ../../.oxlintrc.json ./src",
    "fix": "node ../../node_modules/oxlint/bin/oxlint --config ../../.oxlintrc.json --fix ./src",
    "format": "node node_modules/oxfmt/bin/oxfmt --config ../../.oxfmtrc.json --disable-nested-config --write ./src",
    "format:check": "node node_modules/oxfmt/bin/oxfmt --config ../../.oxfmtrc.json --disable-nested-config --check ./src",
    "test": "node scripts/test.mjs",
    "test:standalone": "node scripts/test.mjs --exclude specs/template-typecheck.spec.ts",
    "format:template": "node scripts/format-check-template.mjs",
    "format:template:fix": "node scripts/format-check-template.mjs --write",
    "typecheck:scaffold": "node scripts/typecheck-scaffold.mjs",
    "typecheck:template": "node scripts/typecheck-template.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "update": "node node_modules/tsx/dist/cli.mjs version-checker.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@mongez/copper": "^2.1.3",
    "@warlock.js/fs": "*",
    "@mongez/reinforcements": "^4.0.2",
    "cross-spawn": "^7.0.3",
    "rimraf": "^6.0.1",
    "which-pm-runs": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.15"
  }
}
