{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "arrowParens": "always",
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": {
    "newlinesBetween": false,
    "internalPattern": ["app/", "web/", "@shared/"]
  },
  "ignorePatterns": ["node_modules/", "dist/"]
}
