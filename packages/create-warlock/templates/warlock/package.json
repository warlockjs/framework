{
  "name": "name-set-by-scaffolder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "warlock dev",
    "build": "warlock generate.typings && tsc && warlock build",
    "start": "warlock start",
    "seed": "warlock seed",
    "migrate": "warlock migrate",
    "migrate.fresh": "warlock migrate --fresh",
    "migrate.list": "warlock migrate --list",
    "jwt": "warlock jwt.generate",
    "gen": "warlock generate.module",
    "gen.s": "warlock generate.service",
    "gen.m": "warlock generate.model",
    "gen.c": "warlock generate.controller",
    "gen.mig": "warlock generate.migration",
    "gen.r": "warlock generate.repository",
    "gen.rs": "warlock generate.resource",
    "lint": "oxlint --fix ./src --max-warnings=0",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write ./src",
    "tsc": "warlock generate.typings && tsc --noEmit",
    "postinstall": "agent-kit init && agent-kit sync || echo \"warning: AI agent skills were NOT synced, so coding agents will not see the @warlock.js skills. Run the skills:sync script.\"",
    "skills:sync": "agent-kit sync",
    "skills:watch": "agent-kit watch",
    "lint:check": "oxlint ./src --max-warnings=0",
    "format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check ./src"
  },
  "dependencies": {
    "@mongez/reinforcements": "^4.0.2",
    "@mongez/localization": "^3.5.1",
    "@mongez/supportive-is": "^3.0.0",
    "@warlock.js/auth": "0.0.0-set-by-scaffolder",
    "@warlock.js/cache": "0.0.0-set-by-scaffolder",
    "@warlock.js/cascade": "0.0.0-set-by-scaffolder",
    "@warlock.js/scheduler": "0.0.0-set-by-scaffolder",
    "@warlock.js/core": "0.0.0-set-by-scaffolder",
    "@warlock.js/fs": "0.0.0-set-by-scaffolder",
    "@warlock.js/logger": "0.0.0-set-by-scaffolder",
    "@warlock.js/seal": "0.0.0-set-by-scaffolder",
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@mongez/agent-kit": "^1.3.1",
    "@types/node": "^25.0.3",
    "typescript": "7.0.2",
    "vitest": "4.0.5",
    "oxlint": "1.88.0",
    "oxfmt": "0.73.0"
  }
}
