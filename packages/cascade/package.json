{
  "name": "@warlock.js/cascade",
  "version": "5.40.1",
  "type": "module",
  "description": "ORM for managing databases",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "bin": {
    "cascade": "./bin/cascade.js"
  },
  "dependencies": {
    "@mongez/copper": "^2.1.3",
    "@mongez/dotenv": "^1.3.3",
    "@mongez/events": "^2.2.8",
    "@mongez/reinforcements": "^4.0.2",
    "@mongez/supportive-is": "^3.0.0",
    "@warlock.js/context": "workspace:^",
    "@warlock.js/logger": "workspace:^",
    "@warlock.js/scheduler": "workspace:^",
    "@warlock.js/seal": "workspace:^",
    "citty": "^0.2.2",
    "fast-glob": "^3.3.3"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "update": "npx ncu -u",
    "fix:test": "node ../../node_modules/oxlint/bin/oxlint --config ../../.oxlintrc.json --fix ./tests",
    "format:test": "node ../../node_modules/oxfmt/bin/oxfmt --config ../../.oxfmtrc.json --disable-nested-config --write ./tests",
    "fix": "node ../../node_modules/oxlint/bin/oxlint --config ../../.oxlintrc.json --fix ./src",
    "format": "node ../../node_modules/oxfmt/bin/oxfmt --config ../../.oxfmtrc.json --disable-nested-config --write ./src",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "test:watch": "vitest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/cascade"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^10.28.0",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.28.2",
    "mongodb": "^7.2.0",
    "npm-check-updates": "^16.10.17",
    "pg": "^8.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "mongodb": "^5.7.0 || ^6.0.0 || ^7.0.0",
    "pg": "^8.16.3"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "keywords": [
    "mongodb",
    "postgres",
    "node",
    "database",
    "orm",
    "mongodb-orm",
    "mongodb-odm",
    "mongodb-orm-node",
    "entity",
    "model",
    "aggregate",
    "aggregate-framework"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "packageManager": "pnpm@11.24.0"
}
