{
  "name": "@warlock.js/notifications",
  "version": "5.35.0",
  "type": "module",
  "description": "Multi-channel notifications for Warlock.js — define once, fire anywhere; mail / in-app database / pluggable custom channels with preferences, rate limits, and idempotency.",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "dependencies": {
    "@warlock.js/cache": "workspace:^",
    "@warlock.js/cascade": "workspace:^",
    "@warlock.js/core": "workspace:^",
    "@warlock.js/logger": "workspace:^"
  },
  "peerDependencies": {
    "@warlock.js/herald": "5.35.0",
    "@warlock.js/queue": "5.35.0"
  },
  "peerDependenciesMeta": {
    "@warlock.js/herald": {
      "optional": true
    },
    "@warlock.js/queue": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "generate:llms": "node scripts/generate-llms.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/notifications"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "5.0.3",
    "@warlock.js/herald": "workspace:^",
    "@warlock.js/queue": "workspace:^",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "keywords": [
    "notifications",
    "mail",
    "in-app",
    "multi-channel",
    "warlock.js",
    "typescript"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0"
}
