{
  "name": "@warlock.js/ai-groq",
  "version": "5.23.3",
  "type": "module",
  "description": "Groq adapter for @warlock.js/ai (OpenAI-compatible, thin wrapper over @warlock.js/ai-openai)",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "warlock",
    "ai",
    "groq",
    "llama",
    "openai-compatible"
  ],
  "author": "Hasan Zohdy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/ai-groq"
  },
  "devDependencies": {
    "@warlock.js/ai": "workspace:^",
    "typescript": "^5.0.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@warlock.js/ai": "*"
  },
  "dependencies": {
    "@warlock.js/ai-openai": "workspace:^",
    "@warlock.js/logger": "workspace:^"
  },
  "packageManager": "pnpm@11.24.0"
}
