{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warlock inspect report",
  "description": "Output of `warlock inspect --json`, schema version 1.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "app", "sections", "components", "warnings"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "required": ["name", "version", "root", "node", "environment", "runtimeStrategy"],
      "properties": {
        "name": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "root": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "runtimeStrategy": {
          "type": "string"
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "enum": [
          "routes",
          "models",
          "resources",
          "config",
          "events",
          "pages",
          "jobs",
          "schedules",
          "packages",
          "files"
        ]
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "name",
          "sourceFile",
          "handler",
          "description",
          "isPage",
          "middleware",
          "auth",
          "csrf",
          "rateLimit",
          "logging",
          "request",
          "responses"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          },
          "sourceFile": {
            "type": ["string", "null"]
          },
          "handler": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "isPage": {
            "type": "boolean"
          },
          "middleware": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auth": {
            "type": "object",
            "required": ["required", "sources", "userTypes"],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "sources": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "const": "header"
                    },
                    {
                      "type": "object",
                      "required": ["cookie"],
                      "properties": {
                        "cookie": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              },
              "userTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "csrf": {
            "type": "boolean"
          },
          "rateLimit": {
            "type": "object",
            "required": ["source", "max", "timeWindow"],
            "properties": {
              "source": {
                "enum": ["route", "global", "none"]
              },
              "max": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": "dynamic"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeWindow": {
                "type": ["number", "string", "null"]
              }
            }
          },
          "logging": {
            "type": "object",
            "required": ["body", "query", "privateRules"],
            "properties": {
              "body": {
                "type": "boolean"
              },
              "query": {
                "type": "boolean"
              },
              "privateRules": {
                "type": "boolean"
              }
            }
          },
          "request": {
            "type": "object",
            "required": ["parameters", "body", "customValidation"],
            "properties": {
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "in", "required", "schema"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "in": {
                      "enum": ["path", "query", "header", "cookie"]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "schema": {
                      "type": "object"
                    }
                  }
                }
              },
              "body": {
                "type": ["object", "null"]
              },
              "customValidation": {
                "type": "boolean"
              }
            }
          },
          "responses": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["description", "schema"],
              "properties": {
                "description": {
                  "type": "string"
                },
                "schema": {
                  "type": ["object", "null"]
                }
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "table",
          "primaryKey",
          "dataSource",
          "sourceFile",
          "registered",
          "columns",
          "relations",
          "resource",
          "deleteStrategy",
          "createdAtColumn",
          "updatedAtColumn",
          "deletedAtColumn"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "table": {
            "type": ["string", "null"]
          },
          "primaryKey": {
            "type": ["string", "null"]
          },
          "dataSource": {
            "type": ["string", "null"]
          },
          "sourceFile": {
            "type": ["string", "null"]
          },
          "registered": {
            "type": "boolean"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "required", "schema"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "model", "foreignKey", "localKey"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "model": {
                  "type": ["string", "null"]
                },
                "foreignKey": {
                  "type": ["string", "null"]
                },
                "localKey": {
                  "type": ["string", "null"]
                }
              }
            }
          },
          "resource": {
            "type": ["string", "null"]
          },
          "deleteStrategy": {
            "type": ["string", "null"]
          },
          "createdAtColumn": {
            "type": ["string", "null"]
          },
          "updatedAtColumn": {
            "type": ["string", "null"]
          },
          "deletedAtColumn": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "schema", "models"],
        "properties": {
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "type", "file"],
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "file": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "listeners"],
        "properties": {
          "event": {
            "type": "string"
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "sourceFile"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sourceFile": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "name", "file", "layouts", "loaders", "actions", "guard"],
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          },
          "file": {
            "type": "string"
          },
          "layouts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "loaders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guard": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "queue", "attempts", "backoff", "removeOnComplete", "removeOnFail"],
        "properties": {
          "name": {
            "type": "string"
          },
          "queue": {
            "type": "string"
          },
          "attempts": {
            "type": ["number", "null"]
          },
          "backoff": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["type", "delay"],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "delay": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "removeOnComplete": {
            "type": ["boolean", "number", "null"]
          },
          "removeOnFail": {
            "type": ["boolean", "number", "null"]
          }
        }
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cron", "intervals", "nextRun"],
        "properties": {
          "name": {
            "type": "string"
          },
          "cron": {
            "type": ["string", "null"]
          },
          "intervals": {
            "type": "object"
          },
          "nextRun": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "required": ["schemas"],
      "properties": {
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "source"],
        "properties": {
          "code": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^WL[0-9]{4}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "module", "role", "exports", "imports", "importedBy"],
        "properties": {
          "file": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "exports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "importedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["specifier", "file"],
              "properties": {
                "specifier": {
                  "type": "string"
                },
                "file": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        }
      }
    }
  }
}
