{
  // Check the shipped ESM source and tests against workspace sources. Bundler
  // resolution matches esbuild; verbatim imports also catch runtime type imports.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "noEmit": true,
    // Guards the defect class this config exists to catch: esbuild's from-source
    // boot transpiles TypeScript file-by-file (see bin/warlock.js's
    // `bootFromSource`), so a plain `import { X }` where `X` is only ever a type
    // survives the per-file transform and crashes Node at import time with
    // "does not provide an export named 'X'". `verbatimModuleSyntax` turns that
    // into a compile-time TS1484 here instead of a runtime crash in `warlock dev`.
    "verbatimModuleSyntax": true,
    // `rootDir` only constrains emit, and this config emits nothing. Inheriting
    // `src` would reject every file under `tests/`, and sibling sources resolved
    // through `paths` live above this package — so the program root is the
    // workspace folder.
    "rootDir": "..",
    "paths": {
      "@warlock.js/cascade": ["../cascade/src/index.ts"],
      "@warlock.js/seal": ["../seal/src/index.ts"],
      "@warlock.js/cache": ["../cache/src/index.ts"],
      "@warlock.js/context": ["../context/src/index.ts"],
      "@warlock.js/herald": ["../herald/src/index.ts"],
      "@warlock.js/access": ["../access/src/index.ts"],
      "@warlock.js/auth": ["../auth/src/index.ts"],
      "@warlock.js/notifications": ["../notifications/src/index.ts"],
      "@warlock.js/core": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests/acceptance/pnpm-production-app",
    "tests/acceptance/runtime-app",
    "tests/fixtures/vitest-exit-app"
  ]
}
