{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./src",
    "paths": { "app/*": ["app/*"], "web/*": ["web/*"] }
  },
  "include": ["src", "warlock.config.ts"],
  "exclude": ["node_modules", "dist", ".warlock"]
}
