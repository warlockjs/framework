{
  "name": "@warlock.js/sitemap",
  "version": "5.14.0",
  "description": "Runtime sitemap.xml generation for Warlock.js — walks the page registry, honours exclusion rules, and reports dynamic routes it cannot enumerate.",
  "type": "module",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/sitemap"
  },
  "peerDependencies": {
    "@warlock.js/core": "*",
    "@warlock.js/web": "*"
  },
  "devDependencies": {
    "vitest": "4.1.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
