{
  "name": "@warlock.js/sitemap",
  "version": "5.40.0",
  "description": "A framework-blind sitemap builder: entries in, a valid sitemaps.org document out. Zero runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/sitemap"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.24.0"
}
