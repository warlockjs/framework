{
  "name": "@warlock.js/sitemap",
  "version": "5.15.0",
  "description": "A framework-blind sitemap builder: entries in, a valid sitemaps.org document out. Zero runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/sitemap"
  },
  "peerDependencies": {
    "@warlock.js/core": "*",
    "@warlock.js/web": "*"
  },
  "peerDependenciesMeta": {
    "@warlock.js/core": {
      "optional": true
    },
    "@warlock.js/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@warlock.js/core": "workspace:^",
    "@warlock.js/web": "workspace:^",
    "vitest": "4.1.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
