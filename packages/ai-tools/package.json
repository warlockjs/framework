{
  "name": "@warlock.js/ai-tools",
  "version": "4.9.0",
  "type": "module",
  "description": "Ready-made agent tools (web search, fetch, HTTP, calculator, date-time) + an MCP client/server for @warlock.js/ai",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "llms": "node scripts/generate-llms.mjs"
  },
  "keywords": [
    "warlock",
    "ai",
    "agent",
    "tools",
    "web-search",
    "fetch",
    "http",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Hasan Zohdy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/ai-tools"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "*",
    "@mozilla/readability": "*",
    "@tavily/core": "*",
    "@warlock.js/ai": "*",
    "ajv": "*",
    "jsdom": "*"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@mozilla/readability": {
      "optional": true
    },
    "@tavily/core": {
      "optional": true
    },
    "ajv": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  }
}
