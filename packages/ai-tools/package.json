{
  "name": "@warlock.js/ai-tools",
  "version": "5.40.1",
  "type": "module",
  "description": "Ready-made agent tools (web search, fetch, HTTP, calculator, date-time) + an MCP client/server for @warlock.js/ai",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "llms": "node scripts/generate-llms.mjs"
  },
  "keywords": [
    "warlock",
    "ai",
    "agent",
    "tools",
    "web-search",
    "fetch",
    "http",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Hasan Zohdy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/ai-tools"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@warlock.js/ai": "workspace:^",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@mozilla/readability": "*",
    "@tavily/core": "*",
    "@warlock.js/ai": "*",
    "ajv": "*",
    "jsdom": "*"
  },
  "peerDependenciesMeta": {
    "@mozilla/readability": {
      "optional": true
    },
    "@tavily/core": {
      "optional": true
    },
    "ajv": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
