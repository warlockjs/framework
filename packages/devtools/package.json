{
  "name": "@warlock.js/devtools",
  "version": "5.63.1",
  "type": "module",
  "description": "Dashboard for Warlock.js apps: request timeline, queries with EXPLAIN, N+1 detection, resources, health, errors, logs and jobs. Loopback-only at /__warlock in development; an opt-in, signed-in monitor at a secret path in production.",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./production": {
      "types": "./src/production/index.ts",
      "import": "./src/production/index.ts",
      "default": "./src/production/index.ts"
    }
  },
  "files": [
    "src",
    "ui",
    "skills",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "build:ui": "vite build --config ui-src/vite.config.ts && node ui-src/scripts/write-build-info.mjs",
    "dev:ui": "vite --config ui-src/vite.config.ts",
    "generate:llms": "node scripts/generate-llms.mjs"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^13.1.0",
    "@warlock.js/ai-panoptic": "5.63.1",
    "@warlock.js/cache": "5.63.1",
    "@warlock.js/cascade": "5.63.1",
    "@warlock.js/core": "5.63.1",
    "@warlock.js/logger": "5.63.1",
    "@warlock.js/queue": "5.63.1",
    "@warlock.js/scheduler": "5.63.1"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/server": {
      "optional": true
    },
    "@warlock.js/ai-panoptic": {
      "optional": true
    },
    "@warlock.js/cache": {
      "optional": true
    },
    "@warlock.js/cascade": {
      "optional": true
    },
    "@warlock.js/queue": {
      "optional": true
    },
    "@warlock.js/scheduler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@simplewebauthn/browser": "13.1.0",
    "@simplewebauthn/server": "13.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.2",
    "@warlock.js/ai-panoptic": "workspace:^",
    "@warlock.js/cache": "workspace:^",
    "@warlock.js/cascade": "workspace:^",
    "@warlock.js/core": "workspace:^",
    "@warlock.js/logger": "workspace:^",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "^5.12.6",
    "jsdom": "30.0.1",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "uqr": "0.1.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/devtools"
  },
  "keywords": [
    "warlock.js",
    "devtools",
    "debugging",
    "profiler",
    "n+1",
    "timeline",
    "mailbox",
    "monitoring",
    "production"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0"
}
