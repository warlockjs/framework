{
  "name": "@warlock.js/devtools",
  "version": "5.26.1",
  "type": "module",
  "description": "Development-only dashboard for Warlock.js apps at /__warlock: request timeline, queries with EXPLAIN, N+1 detection, dev mailbox, logs, cache operations and the route map. Refuses to run outside development.",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "ui",
    "skills",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:llms": "node scripts/generate-llms.mjs"
  },
  "peerDependencies": {
    "@warlock.js/cache": "5.26.1",
    "@warlock.js/cascade": "5.26.1",
    "@warlock.js/core": "5.26.1",
    "@warlock.js/logger": "5.26.1"
  },
  "peerDependenciesMeta": {
    "@warlock.js/cache": {
      "optional": true
    },
    "@warlock.js/cascade": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@warlock.js/cache": "workspace:^",
    "@warlock.js/cascade": "workspace:^",
    "@warlock.js/core": "workspace:^",
    "@warlock.js/logger": "workspace:^",
    "fastify": "^5.12.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/devtools"
  },
  "keywords": [
    "warlock.js",
    "devtools",
    "debugging",
    "profiler",
    "n+1",
    "timeline",
    "mailbox"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0"
}
