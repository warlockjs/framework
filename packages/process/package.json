{
  "name": "@warlock.js/process",
  "version": "5.38.0",
  "type": "module",
  "description": "App-owned child process supervision with verified identity and resource limits",
  "keywords": [
    "warlock",
    "process",
    "supervisor",
    "pty"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git",
    "directory": "packages/process"
  },
  "bugs": {
    "url": "https://github.com/warlockjs/framework/issues"
  },
  "homepage": "https://warlock.js.org",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
