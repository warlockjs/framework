{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "react", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/esm/**",
    "**/cjs/**",
    "**/coverage/**",
    "**/.astro/**",
    "**/.warlock/**",
    "**/.skill-snippet-gate-tmp/**",
    ".tmp/**",
    "temp/**",
    "tools/release/builds/**",
    "tools/release/sources/**",
    "packages/create-warlock/templates/**"
  ]
}
