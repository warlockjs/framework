{
  "name": "warlock-framework",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Warlock.js framework: every @warlock.js/* package, create-warlock, the documentation site and the release tooling. Private, not published; each package is published to npm on its own.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlockjs/framework.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "lint:oxlint": "oxlint --config .oxlintrc.json packages scripts docs/scripts tools/release/scripts",
    "typecheck": "pnpm --recursive --filter \"./packages/**\" --no-bail run typecheck",
    "test": "pnpm --recursive --filter \"./packages/**\" --workspace-concurrency=1 --no-bail run test",
    "docs:dev": "pnpm --filter @warlock.js/docs dev",
    "docs:build": "pnpm --filter @warlock.js/docs build",
    "check:public-text": "node scripts/check-public-text.mjs",
    "check:release-notes": "node scripts/sync-release-notes.mjs --check",
    "sync:release-notes": "node scripts/sync-release-notes.mjs",
    "check:spec-coverage": "node scripts/check-spec-coverage.mjs",
    "ci:affected": "node scripts/ci/affected-packages.mjs",
    "release:version": "node scripts/release/set-version.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "format": "oxfmt --config .oxfmtrc.json --disable-nested-config --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --disable-nested-config --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
    "docs:references": "node scripts/regenerate-llms.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@aws-sdk/client-s3": "^3.955.0",
    "@aws-sdk/client-sesv2": "^3.1026.0",
    "@aws-sdk/lib-storage": "^3.955.0",
    "@aws-sdk/s3-request-presigner": "^3.955.0",
    "@inquirer/input": "^5.0.11",
    "@inquirer/prompts": "^8.2.0",
    "@mongez/agent-kit": "^1.3.1",
    "@mongez/collection": "^1.4.1",
    "@mongez/encryption": "^2.0.2",
    "@mongez/fs": "^3.0.5",
    "@mongez/scheduler": "^1.0.0",
    "@mongez/sitemap": "^1.0.2",
    "@mongez/vite": "^2.2.1",
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.5",
    "@react-email/tailwind": "^2.0.7",
    "@testcontainers/mongodb": "^10.16.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/amqplib": "^0.10.8",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "jsonc-parser": "3.3.1",
    "llama3-tokenizer-js": "^1.2.0",
    "marked-terminal": "^7.3.0",
    "mongodb": "^7.0.0",
    "nodemailer": "^8.0.5",
    "ora": "^9.3.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "pg": "^8.16.3",
    "pluralize-esm": "^9.0.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "testcontainers": "^11.11.0",
    "tiktoken": "^1.0.22",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mongez/dotenv": "^1.3.3",
    "get-tsconfig": "5.0.0-beta.5"
  },
  "agentKit": {
    "targets": [
      "claude",
      "codex"
    ]
  }
}
